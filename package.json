{
    "name": "cross-domain-utils",
    "version": "4.0.1",
    "description": "Window and origin helpers for code that talks across frames and popups: who is my parent, opener or top, is this window closed, is it same-origin, does this origin match that pattern.",
    "keywords": [
        "cross-domain",
        "cross-origin",
        "iframe",
        "popup",
        "window",
        "postmessage",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/cross-domain-utils#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/cross-domain-utils/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/cross-domain-utils.git"
    },
    "license": "Apache-2.0",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cugel-scripts build",
        "fix": "cugel-scripts fix --changed",
        "fix:all": "cugel-scripts fix",
        "imports:missing": "cugel-scripts imports:missing --changed",
        "lint": "cugel-scripts lint",
        "test:static": "cugel-scripts static",
        "test:unit": "cugel-scripts test --coverage",
        "test:watch": "cugel-scripts test --watch",
        "test": "npm run test:static && npm run test:unit && npm run build",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "cugel-scripts": "^0.1.0",
        "esbuild": "^0.28.0"
    }
}
